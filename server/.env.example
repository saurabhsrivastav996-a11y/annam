# ---- Core ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Auth ----
# CHANGE THIS in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=annam_dev_secret_change_me
JWT_EXPIRES_IN=7d

# ---- Database ----
# Leave empty to auto-start an in-memory MongoDB (zero setup, data resets on restart).
# For persistence, use MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/annam
MONGODB_URI=

# ---- Email notifications (optional) ----
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters below.
# Leave blank and Annam simply sends no email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Annam <your.address@gmail.com>

# ---- Natural-language search (optional) ----
# Without this, search still works via a rules parser that understands price
# caps, veg/non-veg, spice level and cuisine. With it, Claude handles free-form
# phrasing too. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Payments (optional) ----
# Without these, checkout falls back to cash on delivery + a simulated card.
# Test keys from https://dashboard.razorpay.com/app/website-app-settings/api-keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed if you configure the payment.captured / payment.failed webhook
RAZORPAY_WEBHOOK_SECRET=

# ---- Media (optional) ----
# Without these, uploads are stored on local disk at server/uploads and served from /uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
