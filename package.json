{
  "name": "annam",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Annam (अन्नम्) - food delivery with reels, kitchen transparency and the Annadevta donation module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "db": "node scripts/start-mongo.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "seed": "npm run seed --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "lint": "eslint .",
    "build:all": "npm run build --workspace client",
    "clean:temp": "node scripts/clean-temp.mjs",
    "shots": "cypress run --config specPattern=scripts/screenshots/capture.cy.js,screenshotsFolder=docs/screenshots,viewportWidth=1440,viewportHeight=900,video=false,retries=0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.2",
    "cypress": "^15.21.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
